---
layout: base.njk
title: Sailing & Cybersecurity
---

<!-- Hero Section -->
<header class="hero hero-photo">
    <div class="hero-bg"></div>
    <div class="container hero-content">
        <h1>Sailing & <span class="highlight">Cybersecurity</span></h1>
        <p class="hero-subtitle">I'm Austin — I write about life on the water and security in the digital world.</p>
        <div class="hero-buttons">
            <a href="/blog/" class="btn btn-primary">Read the Blog</a>
        </div>
    </div>
    <div class="hero-wave">
        <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
            <path d="M0,60 C360,120 720,0 1080,60 C1260,90 1380,70 1440,60 L1440,120 L0,120 Z" fill="#ffffff"/>
        </svg>
    </div>
</header>

<!-- Blog Section -->
<section class="section blog" id="blog">
    <div class="container">
        <div class="section-header">
            <h2>Latest Posts</h2>
            <div class="section-divider"></div>
            <p class="section-subtitle">Thoughts on sailing, cybersecurity, and where they intersect</p>
        </div>
        {% set postList = collections.posts %}
        {% if postList | length > 0 %}
        <div class="blog-grid">
            {% for post in postList | limit(3) %}
            <article class="blog-card">
                <a href="{{ post.url }}">
                    <div class="blog-card-image" style="{% if post.data.cover %}background-image: linear-gradient(rgba(10,36,99,0.3), rgba(10,36,99,0.3)), url('{{ post.data.cover }}'); background-size: cover; background-position: center;{% else %}background: linear-gradient(135deg, {{ post.data.gradient[0] | default('#0a2463') }}, {{ post.data.gradient[1] | default('#1e6091') }});{% endif %}">
                        {% if post.data.tags %}
                            {% for tag in post.data.tags %}
                                {% if tag != "posts" %}
                                <span class="blog-tag">{{ tag }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="blog-card-content">
                        <time class="blog-date">{{ post.date | dateShort }}</time>
                        <h3>{{ post.data.title }}</h3>
                        <p>{{ post.data.excerpt | default(post.data.description) }}</p>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
        <div class="blog-cta">
            <a href="/blog/" class="btn btn-primary">View All Posts</a>
        </div>
        {% else %}
        <div class="blog-empty">
            <p>Posts coming soon. Stay tuned.</p>
        </div>
        {% endif %}
    </div>
</section>
