---
layout: base.njk
navScrolled: true
hideFooterWave: true
---

<article class="post">
    <header class="post-header" {% if cover %}style="background: linear-gradient(rgba(10,36,99,0.6), rgba(10,36,99,0.75)), url('{{ cover }}') center/cover;"{% endif %}>
        <div class="container">
            <div class="post-meta">
                {% if tags %}
                    {% for tag in tags %}
                        {% if tag != "posts" %}
                        <span class="blog-tag">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <time class="blog-date">{{ date | dateFormat }}</time>
            </div>
            <h1>{{ title }}</h1>
            {% if subtitle %}
            <p class="post-subtitle">{{ subtitle }}</p>
            {% endif %}
        </div>
    </header>
    <div class="container">
        <div class="post-content">
            {{ content | safe }}
        </div>
        <div class="post-footer">
            <a href="/blog/" class="btn btn-outline">&larr; Back to Blog</a>
        </div>
    </div>
</article>
