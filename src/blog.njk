---
layout: base.njk
title: Blog
navScrolled: true
hideFooterWave: true
permalink: /blog/
---

<header class="blog-header">
    <div class="container">
        <h1>Blog</h1>
        <p>Thoughts on sailing, cybersecurity, and where they intersect.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        {% set postList = collections.posts %}
        {% if postList | length > 0 %}
        <div class="blog-grid">
            {% for post in postList %}
            <article class="blog-card">
                <a href="{{ post.url }}">
                    <div class="blog-card-image" style="{% if post.data.cover %}background-image: linear-gradient(rgba(10,36,99,0.3), rgba(10,36,99,0.3)), url('{{ post.data.cover }}'); background-size: cover; background-position: center;{% else %}background: linear-gradient(135deg, {{ post.data.gradient[0] | default('#0a2463') }}, {{ post.data.gradient[1] | default('#1e6091') }});{% endif %}">
                        {% if post.data.tags %}
                            {% for tag in post.data.tags %}
                                {% if tag != "posts" %}
                                <span class="blog-tag">{{ tag }}</span>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="blog-card-content">
                        <time class="blog-date">{{ post.date | dateShort }}</time>
                        <h3>{{ post.data.title }}</h3>
                        <p>{{ post.data.excerpt | default(post.data.description) }}</p>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
        {% else %}
        <div class="blog-empty">
            <p>Posts coming soon. Stay tuned.</p>
        </div>
        {% endif %}
    </div>
</section>
